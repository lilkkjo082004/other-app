# Copy to ".env" and fill in to connect the app to real Claude responses.
# Without these, the app uses built-in placeholder companion responses.

# URL of your deployed Cloudflare Worker proxy (see worker/README.md):
VITE_AI_PROXY=https://other-ai.<you>.workers.dev

# Optional — model the proxy requests. Defaults to claude-opus-4-8.
# claude-sonnet-4-6 is a cheaper/faster option for high chat volume.
# VITE_AI_MODEL=claude-opus-4-6
