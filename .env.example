# Copy to ".env" and fill in to connect the app to real Claude responses.
# Without these, the app uses built-in placeholder companion responses.

# URL of your deployed Cloudflare Worker proxy (see worker/README.md):
VITE_AI_PROXY=https://other-ai.<you>.workers.dev

# Optional — model the proxy requests. Defaults to claude-opus-4-8.
# claude-sonnet-4-6 is a cheaper/faster option for high chat volume.
# VITE_AI_MODEL=claude-opus-4-6

# Backend base URL (server/) — enables accounts, cloud sync, mood, and push.
# When set, the app talks to this instead of VITE_AI_PROXY for AI too.
# VITE_API_BASE=https://other-api.<you>.workers.dev

# Natural (AI) companion voices via the backend /tts proxy (ElevenLabs).
# Requires VITE_API_BASE and the worker's ELEVENLABS_API_KEY secret. Falls back
# to browser speech synthesis when off or unavailable.
# VITE_NATURAL_VOICE=1

# Web Push public (VAPID) key — enables companion check-in notifications.
# Generate a keypair, set the private half as the worker's VAPID_PRIVATE
# secret, and paste the public half here (it must match the worker's
# VAPID_PUBLIC var). Requires VITE_API_BASE and a signed-in account.
# VITE_VAPID_PUBLIC=B...

# Google Calendar integration (optional): an OAuth "Web application" client id
# from Google Cloud Console with your app origin authorized. Enables one-tap
# event add + companions seeing the user's upcoming events (with consent).
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
